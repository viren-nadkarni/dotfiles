// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
[
  {
    "context": "FileFinder > Picker > Editor",
    "bindings": {
      "ctrl-f": "text_finder::Toggle",
    },
  },
  {
    "context": "TextFinder > Picker > Editor",
    "bindings": {
      "ctrl-f": "file_finder::Toggle",
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-[": [
        "workspace::SendKeystrokes",
        "escape"
      ],
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-shift-v": "pane::SplitRight",
      "ctrl-shift-x": "pane::SplitDown",
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "bindings": {
      "ctrl-c": [
        "workspace::SendKeystrokes",
        "cmd-c"
      ],
      "ctrl-v": [
        "workspace::SendKeystrokes",
        "cmd-v"
      ],
      "ctrl-a": [
        "workspace::SendKeystrokes",
        "cmd-a"
      ],
      "ctrl-x": [
        "workspace::SendKeystrokes",
        "cmd-x"
      ],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-p": "pane::ActivatePreviousItem",
      "ctrl-shift-n": "pane::ActivateNextItem",
    }
  },
  {
    "context": "Editor && renaming",
    "bindings": {
      "ctrl-[": [
        "workspace::SendKeystrokes",
        "escape"
      ],
    }
  },
  {
    "context": "Editor || Terminal",
    "bindings": {
      "ctrl-shift-c": "editor::Copy",
      "ctrl-shift-v": "editor::Paste",
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      ", d": "editor::GoToDefinition",
      ", u": "editor::FindAllReferences",
      ", r": "editor::Rename",
      ", b": "git::Blame",
      ", x": "pane::SplitDown",
      ", v": "pane::SplitRight",
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "` `": "pane::GoBack",
      ";": "file_finder::Toggle",
      "\\": "workspace::ToggleRightDock",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-\\": "outline::Toggle",
      "ctrl-;": "assistant::InlineAssist",
      "ctrl-enter": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-enter": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && (showing_completions || showing_code_actions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },
  {
    "context": "AgentPanel > Editor",
    "bindings": {
      "ctrl-y": "agent::AllowOnce",
      "ctrl-n": "agent::RejectOnce",
      "tab": "agent::CycleModeSelector",
      "ctrl-p": "agent::ToggleModelSelector",
    }
  }
]
