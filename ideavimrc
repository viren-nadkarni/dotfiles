Plug 'tpope/vim-surround'

let mapleader=','

" Run :actionlist for supported actions
nmap <Leader>d :action GotoDeclaration<CR>
nmap <Leader>u :action ShowUsages<CR>
nmap <Leader>s :action GotoSuperMethod<CR>
nmap <Leader>i :action GotoImplementation<CR>
nmap <Leader>t :action GotoTest<CR>
nmap <Leader>r :action RenameElement<CR>
vmap <Leader>c :action CommentByLineComment<CR>

nmap <Leader>f :action ShowHoverInfo<CR>
nmap <Leader>b :action Annotate<CR>

nmap <Leader>x :action SplitVertically<CR>
nmap <Leader>v :action SplitHorizontally<CR>

nmap <C-h> <action>(PrevSplitter)
nmap <C-l> <action>(NextSplitter)
nmap <C-S-p> <action>(PreviousTab)
nmap <C-S-n> <action>(NextTab)

nmap <C-;> <action>(SearchEverywhere)
nmap <C- > <action>(CodeCompletion)
nmap <C-CR> <action>(ShowIntentionActions)

set incsearch
set ignorecase
set smartcase

set scrolloff=4
set number

set hlsearch
set showcmd
set noshowmode
set novisualbell

set undolevels=1000
